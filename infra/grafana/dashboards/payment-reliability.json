  "panels": [
    { "type": "timeseries", "title": "Payment rail outcomes", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (rail, outcome) (rate(vpulse_rail_requests_total[5m]))", "legendFormat": "{{rail}} / {{outcome}}" }] },
    { "type": "timeseries", "title": "HTTP p95 latency", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95" }] },
    { "type": "stat", "title": "Rate-limit rejections / 5m", "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 }, "targets": [{ "expr": "sum(increase(vpulse_rate_limit_total{outcome=\"rejected\"}[5m]))" }] },
    { "type": "stat", "title": "Backend availability", "gridPos": { "h": 6, "w": 8, "x": 8, "y": 9 }, "targets": [{ "expr": "up{job=\"vpulse-backend\"}" }] }

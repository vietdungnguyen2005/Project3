{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    { "type": "timeseries", "title": "Payment rail outcomes", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (rail, outcome) (rate(vpulse_rail_requests_total[5m]))", "legendFormat": "{{rail}} / {{outcome}}" }] },
    { "type": "timeseries", "title": "HTTP p95 latency", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95" }] },
    { "type": "stat", "title": "Rate-limit rejections / 5m", "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 }, "targets": [{ "expr": "sum(increase(vpulse_rate_limit_total{outcome=\"rejected\"}[5m]))" }] },
    { "type": "stat", "title": "Backend availability", "gridPos": { "h": 6, "w": 8, "x": 8, "y": 9 }, "targets": [{ "expr": "up{job=\"vpulse-backend\"}" }] },
    { "type": "stat", "title": "Oldest unresolved instruction / seconds", "gridPos": { "h": 6, "w": 8, "x": 16, "y": 9 }, "targets": [{ "expr": "vpulse_reconciliation_oldest_unresolved_seconds" }] },
    { "type": "timeseries", "title": "Reconciliation observations / 5m", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 }, "targets": [{ "expr": "sum by (outcome) (increase(vpulse_reconciliation_attempts_total[5m]))", "legendFormat": "{{outcome}}" }] },
    { "type": "timeseries", "title": "Mean lookup lifecycle latency / seconds", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 }, "targets": [{ "expr": "sum(rate(vpulse_reconciliation_latency_seconds_sum[5m])) / sum(rate(vpulse_reconciliation_latency_seconds_count[5m]))", "legendFormat": "mean" }] },
    { "type": "stat", "title": "Provider lookup failures / 5m", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 }, "targets": [{ "expr": "sum(increase(vpulse_reconciliation_lookup_failures_total[5m]))" }] },
    { "type": "stat", "title": "Unsafe replay requests blocked / 5m", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 }, "targets": [{ "expr": "sum(increase(vpulse_replay_unsafe_rejected_total[5m]))" }] }
  ],
  "schemaVersion": 42,
  "tags": ["payments", "reliability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Payment Reliability",
  "uid": "vpulse-reliability",
  "version": 2
}

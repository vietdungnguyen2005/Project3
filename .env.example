# Next.js / Cloudflare BFF (server-side only)
BACKEND_ORIGIN=http://localhost:8080
BFF_SHARED_SECRET=local-bff-secret
VPULSE_OPS_SECRET=local-ops-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/vpulse
SPRING_DATASOURCE_USERNAME=vpulse
SPRING_DATASOURCE_PASSWORD=vpulse
SPRING_DATA_REDIS_URL=redis://localhost:6381
DEPLOYMENT_ENVIRONMENT=local
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
VPULSE_DEMO_DATA_ENABLED=false

# Cloudflare deployment credentials (CLI only; never runtime client variables)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

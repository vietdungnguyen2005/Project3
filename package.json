{
  "name": "v-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "cf:check": "node scripts/cloudflare.mjs check",
    "cf:build": "node scripts/cloudflare.mjs build",
    "preview": "node scripts/cloudflare.mjs preview",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "upload": "node scripts/cloudflare.mjs upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "minimatch@8.0.7": "10.2.5",
    "js-yaml": "4.3.1",
    "nanoid": "6.0.1",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  }
}
